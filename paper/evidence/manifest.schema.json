{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ardevo.local/schemas/paper-evidence-v2.json",
  "title": "ArdEVO paper evidence manifest",
  "oneOf": [
    {"$ref": "#/$defs/manifestV1"},
    {"$ref": "#/$defs/manifestV2"}
  ],
  "$defs": {
    "manifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manuscript", "claims", "figures"],
      "properties": {
        "schema_version": {"const": 1},
        "manuscript": {"$ref": "#/$defs/manuscriptArtifact"},
        "claims": {"$ref": "#/$defs/claims"},
        "figures": {"$ref": "#/$defs/figures"}
      }
    },
    "manifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manuscripts", "claims", "figures"],
      "properties": {
        "schema_version": {"const": 2},
        "manuscripts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/manuscript"}
        },
        "claims": {"$ref": "#/$defs/claims"},
        "figures": {"$ref": "#/$defs/figures"}
      }
    },
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "artifact": {"$ref": "#/$defs/manuscriptArtifact"}
      }
    },
    "manuscriptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"const": "manuscript"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {
          "enum": ["config", "library", "manuscript", "output", "render", "script", "summary", "transcript"]
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/figure"}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "summary", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "section": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "summary", "evidence", "outputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "section": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
