{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ardevo.local/schemas/paper-evidence-v1.json",
  "title": "ArdEVO paper evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manuscript", "claims", "figures"],
  "properties": {
    "schema_version": {"const": 1},
    "manuscript": {"$ref": "#/$defs/artifact"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/figure"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {
          "enum": ["config", "library", "manuscript", "output", "render", "script", "summary", "transcript"]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "summary", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "section": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "summary", "evidence", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "section": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  }
}
