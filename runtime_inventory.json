  "run_paths": [
    {
      "access": "read",
      "condition": "startup project metadata",
      "path": "pyproject.toml"
    },
    {
      "access": "read",
      "condition": "default startup",
      "path": "configs/orchestrated_overmind_all_features.toml"
    },
    {
      "access": "read-write",
      "condition": "Icarus dataset acquisition and reuse; outside the repository",
      "path": "<Hugging Face datasets cache>"
    },
    {
      "access": "read-write",
      "condition": "library load, admission, statistics, retirement, and optional run-end GC",
      "path": "<library_dir>/index.json"
    },
    {
      "access": "read-write",
      "condition": "library entry load, admission, statistics, and optional run-end GC",
      "path": "<library_dir>/entries/<key>.json"
    },
    {
      "access": "read-write",
      "condition": "routed persistence enabled",
      "path": "<library_dir>/router/router_meta.json"
    },
    {
      "access": "read-write",
      "condition": "routed persistence enabled",
      "path": "<library_dir>/router/router_state.pt"
    },
    {
      "access": "write",
      "condition": "persisted router is incompatible and persist_strict is false",
      "path": "<library_dir>/router_stale_<timestamp>/"
    },
    {
      "access": "read-write",
      "condition": "grammar strategy rebuilds after the live library key set changes",
      "path": "<library_dir>/grammar/grammar.json"
    },
    {
      "access": "delete",
      "condition": "optional run-end GC removes an unreferenced retired entry",
      "path": "<library_dir>/images/<key>.png"
    },
    {
      "access": "write",
      "condition": "routed expert set changes",
      "path": "<library_dir>/images/overmind.png"
    },
    {
      "access": "write",
      "condition": "new run creates <run_dir>; --resume uses the supplied directory instead",
      "path": "results/<timestamp>_orchestrated/"
    },
    {
      "access": "read",
      "condition": "canonical scheduled trainer uses a matching explicit calibration profile when present",
      "path": "results/compute_policy.json"
    },
    {
      "access": "read-write",
      "condition": "source config snapshot written on a new run and loaded by implicit --resume",
      "path": "<run_dir>/config.toml"
    },
    {
      "access": "write",
      "condition": "source config snapshot digest",
      "path": "<run_dir>/config.toml.sha256"
    },
    {
      "access": "read-write",
      "condition": "CLI-adjusted effective config written on a new run and loaded by implicit --resume",
      "path": "<run_dir>/config.effective.json"
    },
    {
      "access": "write",
      "condition": "effective config snapshot digest",
      "path": "<run_dir>/config.effective.json.sha256"
    },
    {
      "access": "write",
      "condition": "[library] fresh_per_task freezes the starting state for the no-memory control",
      "path": "<run_dir>/frozen_library/"
    },
    {
      "access": "read-write",
      "condition": "prior rows load on resume; refreshed at startup, task boundaries, crash, and completion",
      "path": "<run_dir>/run_summary.json"
    },
    {
      "access": "read-write",
      "condition": "loaded on resume and overwritten with rolling resumable state",
      "path": "<run_dir>/checkpoint.json"
    },
    {
      "access": "write",
      "condition": "task admits a library entry",
      "path": "<run_dir>/task_<NNNN>/stats.json"
    },
    {
      "access": "write",
      "condition": "task admits a library entry",
      "path": "<run_dir>/task_<NNNN>/checkpoint.json"
    },
    {
      "access": "write",
      "condition": "task admits a library entry",
      "path": "<run_dir>/task_<NNNN>/net.png"
    },
    {
      "access": "write",
      "condition": "task admits a library entry",
      "path": "<run_dir>/task_<NNNN>/speciation.png"
    }
